# TikTok 选品自动化 - 环境变量模板
# 复制为 .env 并填入真实值

# === 数据源 ===

# EchoTik 官方 API（可选，当前代码默认使用免费 CSV 路径）
# 仅从 EchoTik API Dashboard 获取，不要使用或提交浏览器 Cookie。
ECHOTIK_USERNAME=
ECHOTIK_PASSWORD=

# FastMoss 官方 MCP（优先）及 OpenAPI（可选）
FASTMOSS_MCP_KEY=
FASTMOSS_CLIENT_ID=
FASTMOSS_CLIENT_SECRET=

# === AI 服务 ===

# OpenAI / DeepSeek（评论情感分析用）
# 如果用 DeepSeek（国内可直连），同时设置 OPENAI_BASE_URL
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com

# === 通知服务 ===

# Telegram Bot (@BotFather 创建)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# QQ 邮箱 SMTP（国内最稳定，用来替代 Telegram 通知）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code

# WhatsApp Business API（可选，SEA 客服用）
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_RECIPIENT=

# Google Translate API（可选，泰/越/菲兜底翻译）
# GOOGLE_TRANSLATE_API_KEY=
