# TikTok 选品自动化 - 环境变量模板
# 复制为 .env 并填入真实值

# FastMoss
FAST_MOSS_API_KEY=your_fastmoss_api_key_here

# OpenAI
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Telegram Bot (@BotFather 创建)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# EchoTik (可选，需要 Cookie)
ECHO_TIK_COOKIE=your_echotik_session_cookie_here

# 企业微信 (可选)
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
