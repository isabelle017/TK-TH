# TikTok 选品自动化 - 环境变量模板
# 复制为 .env 并填入真实值

# === 数据源 ===

# EchoTik Cookie（推荐，当前主力数据源）
# 从浏览器登录 https://www.echotik.com 后，复制 Cookie 字符串
ECHO_TIK_COOKIE=

# FastMoss — 无公开 REST API，无需配置

# === AI 服务 ===

# OpenAI / DeepSeek（评论情感分析用）
# 如果用 DeepSeek（国内可直连），同时设置 OPENAI_BASE_URL
OPENAI_API_KEY=sk-proj-your_api_key_here
# OPENAI_BASE_URL=https://api.deepseek.com

# === 通知服务 ===

# Telegram Bot (@BotFather 创建)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# QQ 邮箱 SMTP（国内最稳定，用来替代 Telegram 通知）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code

# WhatsApp Business API（可选，SEA 客服用）
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_RECIPIENT=

# Google Translate API（可选，泰/越/菲兜底翻译）
# GOOGLE_TRANSLATE_API_KEY=
